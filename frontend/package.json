{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
     "sonar:coverage": "npm run test -- --run --coverage && sonar-scanner -Dsonar.projectKey=$SONAR_PROJECT_KEY_FRONTEND -Dsonar.organization=$SONAR_ORGANIZATION_KEY -Dsonar.token=$SONAR_TOKEN -Dsonar.host.url=https://sonarcloud.io -Dsonar.sources=src -Dsonar.tests=src/test -Dsonar.exclusions=src/test/** -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info -Dsonar.branch.name=master -Dsonar.scm.disabled=true"
  },
  "dependencies": {
    "jsdom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@eslint/js": "^9.21.0",
    "@hookform/resolvers": "4.1.2",
    "@mui/icons-material": "^5.7.0",
    "@mui/material": "^5.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.1.2",
    "axios": "^1.8.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^19.0.0",
    "react-hook-form": "7.54.2",
    "react-router-dom": "^6.10.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.8",
    "yup": "1.6.1",
    "sonar-scanner": "^3.0.0"
  }
}